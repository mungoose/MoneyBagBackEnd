<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog

                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet author="Margus" id="changelog-1.0">
        <createTable tableName="clients">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="first_name" type="text">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="last_name" type="text">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="balance" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
        </createTable>

        <createTable tableName="groups">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="client_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_clients_groups"
                             references="clients(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="group_code" type="integer">
                <constraints nullable="false" primaryKey="false" unique="true"/>
            </column>
            <column name="group_name" type="text">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
        </createTable>

        <createTable tableName="transactions">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_clients_transactions"
                             references="clients(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="date" type="date">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
            <column name="payee" type="text">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
            <column name="money_in" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="money_out" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="end_balance" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="locked" type="boolean">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
        </createTable>

        <createTable tableName="transaction_lines">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="transaction_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_transactions_transaction_lines"
                             references="transactions(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="client_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_clients_transactions"
                             references="clients(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="money_in" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="money_out" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="group_code" type="integer">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="group_name" type="text">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
        </createTable>
        <createTable tableName="goal_setter">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_clients_transactions"
                             references="clients(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="group_code" type="integer">
                <constraints nullable="false" foreignKeyName="fk_groups_transaction_lines"
                             references="groups(group_code)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="max_goal" type="numeric">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
        </createTable>

        <createTable tableName="planner">
            <column name="id" type="integer" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_id" type="integer">
                <constraints nullable="false" foreignKeyName="fk_clients_planner"
                             references="clients(id)"
                             primaryKey="false" unique="false"/>
            </column>
            <column name="month_year" type="text">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="group_code" type="integer">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
            <column name="group_name" type="text">
                <constraints nullable="false" primaryKey="false" unique="false"/>
            </column>
            <column name="planned_in" type="numeric">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
            <column name="planned_out" type="numeric">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
            <column name="actual" type="numeric">
                <constraints nullable="true" primaryKey="false" unique="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
